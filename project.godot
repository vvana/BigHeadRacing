; Godot 4 project configuration file.
; Big Head Racing — изометрическая аркадная гонка в стиле Rock'n'Roll Racing.
; Управление регистрируется кодом в scripts/InputSetup.gd (autoload).

config_version=5

[application]

config/name="Big Head Racing"
config/description="Аркадная изометрическая гонка в стиле Rock'n'Roll Racing"
run/main_scene="res://scenes/CarSelect.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

InputSetup="*res://scripts/InputSetup.gd"
GameState="*res://scripts/GameState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

anti_aliasing/quality/msaa_3d=2
