; Godot 4 project configuration file.
; Пыль и Пламя — изометрическая аркадная гонка в стиле Rock'n'Roll Racing.
; Управление регистрируется кодом в scripts/InputSetup.gd (autoload).

config_version=5

[application]

config/name="Пыль и Пламя"
config/description="Аркадная изометрическая гонка в стиле Rock'n'Roll Racing"
; Версия сборки — уезжает в метрики (Analytics.session). Держать в
; согласии с version/name в export_presets.cfg.
config/version="1.1.1"
run/main_scene="res://scenes/CarSelect.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
; Android: «Назад» не закрывает игру — InputSetup вешает KEY_BACK на ui_cancel.
config/quit_on_go_back=false
config/icon="res://assets/ui/icon/icon_192.png"
; Экран загрузки — своё название вместо логотипа Godot (11.09):
; горящее колесо и надпись, картинку собирает tools/gen_splash.py.
; Фон — тот же тёмный, что у иконки (медиана краёв, 27,27,27), чтобы
; плашка колеса на нём не выделялась.
boot_splash/bg_color=Color(0.106, 0.106, 0.106, 1)
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

InputSetup="*res://scripts/InputSetup.gd"
GameState="*res://scripts/GameState.gd"
Net="*res://scripts/Net.gd"
Music="*res://scripts/Music.gd"
Social="*res://scripts/Social.gd"
Analytics="*res://scripts/Analytics.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
; Телефон: только горизонтально (sensor_landscape — оба поворота).
window/handheld/orientation=4

[physics]

; ОБЯЗАТЕЛЬНО для плавности: без этого Engine.get_physics_interpolation_fraction()
; в 4.3 всегда возвращает 0, и вся визуальная интерполяция машин (Car._process,
; IsoCamera) молча вырождается в «показывай прошлый кадр физики» — проверено
; стендом tools/DbgFraction.tscn. Автоинтерполяцию 3D-узлов 4.3 не делает
; (она появилась в 4.4), так что физика от флага не меняется — только дробь.
common/physics_interpolation=true

[rendering]

; Android: текстуры дополнительно импортируются в ETC2/ASTC — без этого
; флага экспорт APK в 4.3 падает с ПУСТЫМ списком «configuration errors»
; (пресетный texture_format/etc2_astc сам по себе не помогает).
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
