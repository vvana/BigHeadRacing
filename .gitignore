# Godot 4: кэш импорта и служебные файлы — генерируются при первом открытии
.godot/
*.translation

# Экспортные сборки (готовая играбельная лежит в dist/ и КОММИТИТСЯ)
/build/
/export/
# КРОМЕ APK: он перевалил за 100 МиБ, а GitHub такие файлы не принимает
# вовсе (отказ GH001 при push, поймано 11.09.2026 — APK 106,3 МиБ).
# Файл остаётся в dist/ на диске и раздаётся игрокам мимо git.
/dist/*.apk
/dist/*.idsig
# export_presets.cfg коммитится: ключей в нём нет, а сборка dist/
# должна воспроизводиться у любого разработчика.

# Отчёты стендов памяти (tools/TestMemLeak, tools/TestMemCycle)
/memleak_report.txt
/memcycle_report.txt

# Системное
Thumbs.db
desktop.ini
.DS_Store
