# Godot 4: кэш импорта и служебные файлы — генерируются при первом открытии
.godot/
*.translation

# Экспортные сборки (готовая играбельная лежит в dist/ и КОММИТИТСЯ)
/build/
/export/
# КРОМЕ APK: он перевалил за 100 МиБ, а GitHub такие файлы не принимает
# вовсе (отказ GH001 при push, поймано 11.09.2026 — APK 106,3 МиБ).
# Файл остаётся в dist/ на диске и раздаётся игрокам мимо git.
/dist/*.apk
/dist/*.idsig
# То же самое для подпапок dist/ (dist/test/ и т.п.): 15.09.2026 push
# снова отклонили из-за dist/test/DustAndFlame.apk (108 МиБ).
/dist/**/*.apk
/dist/**/*.idsig
# export_presets.cfg коммитится: ключей в нём нет, а сборка dist/
# должна воспроизводиться у любого разработчика.

# Отчёты стендов памяти (tools/TestMemLeak, tools/TestMemCycle)
/memleak_report.txt
/memcycle_report.txt

# Системное
Thumbs.db
desktop.ini
.DS_Store

# Android-шаблон сборки Godot (android/build): свои правки (gradle, манифест,
# res) коммитятся, а тяжёлое генерируемое — нет: godot-lib*.aar по ~90 МиБ
# ставит «Проект → Установить шаблон сборки Android», assets/ заполняет экспорт.
/android/build/libs/
/android/build/assets/
/android/build/build/
/android/build/.gradle/

# Бэкапы файлов и свалка скриншотов в корне
*.bak_*
/image*.png
/image*.jpeg
/photo_*.jpg
/tools/_loc_missing.txt
