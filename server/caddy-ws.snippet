# Вставка в /etc/caddy/Caddyfile, блок daf.autovsauto.ru (17.09.2026):
# веб-ворота игры. wss://daf.autovsauto.ru/ws/<порт> → ws://127.0.0.1:<порт>,
# порт только из диапазона игры 98xx/99xx (9870 тестовые веб-ворота и их
# комнаты 9871-9873; 9970-9973 — боевые, когда появятся). Всё остальное
# по-прежнему уходит в панель аналитики (8090).
# С 16.11.2026 это общий сайт аналитики всех игр (E:\UnityProjects\Fish\Server\orca-metrics):
# корень — вход и выпадающий список игр (служба orca-metrics, /hub), /orca/* — «Косатка Мёрдж»
# (через /orca/api/ingest телефоны шлют события), /daf/* — панель «Пыль и Пламя» (8090,
# раньше была в корне). При замене блока НЕ терять /orca/ и /daf/.
daf.autovsauto.ru {
	encode gzip
	@ws path_regexp port ^/ws/(9[89][0-9]{2})$
	handle @ws {
		reverse_proxy 127.0.0.1:{re.port.1}
	}
	redir /orca /orca/ 308
	handle_path /orca/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy 127.0.0.1:8091
	}
	redir /daf /daf/ 308
	handle_path /daf/* {
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		rewrite * /hub{uri}
		reverse_proxy 127.0.0.1:8091
	}
}
