## count УНИКАЛЬНЫХ ников, ни один не совпадает с exclude (имена живых
## игроков и уже розданные). Ников в списке больше сотни, машин в заезде
## максимум 8 — добивка номерами лишь страховка от невозможного.
static func pick(count: int, exclude := PackedStringArray()) -> PackedStringArray:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var pool: Array[String] = NAMES.duplicate()
	# Фишер—Йетс своей RNG (Array.shuffle тасовал бы глобальной).
	for i in range(pool.size() - 1, 0, -1):
		var j := rng.randi_range(0, i)
		var t := pool[i]
		pool[i] = pool[j]
		pool[j] = t
	var res := PackedStringArray()
	for n in pool:
		if res.size() >= count:
			break
		if not exclude.has(n):
			res.append(n)
	while res.size() < count:
		res.append("Игрок %d" % (res.size() + 1))
	return res


## Один свежий ник, не совпадающий ни с кем из exclude.
static func pick_one(exclude := PackedStringArray()) -> String:
	return pick(1, exclude)[0]
